{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/index.css",
      "exclude": {
        "variablePatterns": ["^styles?$"]
      }
    }
  },
  "rules": {
    "tailwindcss/no-unknown-classes": "error"
  }
}
